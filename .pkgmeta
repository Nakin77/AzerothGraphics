package-as: AzerothGraphics

# The addon lives in the AzerothGraphics/ subfolder of the repository.
move-folders:
  AzerothGraphics/AzerothGraphics: AzerothGraphics

# Only what the game loads goes in the download: the logos and the README are
# for the GitHub and CurseForge pages, the game uses Media/Icon.tga only.
ignore:
  - README.md
  - AzerothGraphics/README.md
  - AzerothGraphics/Media/logo*
